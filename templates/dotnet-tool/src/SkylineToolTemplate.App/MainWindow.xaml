<Window x:Class="SkylineToolTemplate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkylineToolTemplate" Height="640" Width="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SkylineToolTemplate" FontSize="22" FontWeight="Bold" Foreground="#1a3c6e" />
        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,4,0,10" Foreground="#555"
                   Text="Not connected to Skyline." TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RunButton" Content="Run" Padding="22,4" FontWeight="Bold" Click="OnRun" />
        </StackPanel>

        <!-- The standard shape: a Settings tab (form controls) + a Log tab (read-only console).
             Add a Review tab (e.g. a ScottPlot WpfPlot) when you need interactive plots. -->
        <TabControl Grid.Row="3" x:Name="MainTabs">
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Settings" FontWeight="Bold" Foreground="#1a3c6e" Margin="0,0,0,8" />
                        <TextBlock Foreground="#888" TextWrapping="Wrap"
                                   Text="Put your tool's options here (combos, checkboxes, paths). Read them in OnRun." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Log" x:Name="LogTab">
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" Background="#fbfbfb" Foreground="#222222" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
